.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE files (your personal settings)
.vscode/
.idea/
*.swp
*.swo

# Testing
/coverage

# Misc
.prettierrc
.eslintrc